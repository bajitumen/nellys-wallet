# Template for .env. Copy this to .env and fill in real values.
# Generate FERNET_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

FERNET_KEY=
DATABASE_URL=sqlite:///instance/finance.db
FLASK_SECRET_KEY=
FLASK_ENV=development

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_PUBLIC_KEY=
# Clerk frontend API host (no protocol). Dashboard → API Keys → "Show JS snippet"
# Example dev: humble-tortoise-12.clerk.accounts.dev
# Example prod: clerk.your-domain.com
CLERK_FRONTEND_API=
# Clerk issuer URL (with protocol) used to pin JWT iss claim.
# Example dev: https://humble-tortoise-12.clerk.accounts.dev
# Example prod: https://clerk.your-domain.com
CLERK_ISSUER=
